# DLHUB Environment Configuration
# =================================
# Copy this file to .env and adjust values as needed

# Application
APP_NAME=DLHUB
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://dlhub:dlhub123@postgres:5432/dlhub

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Storage
DOWNLOAD_DIR=/downloads
TEMP_DIR=/tmp/dlhub
STORAGE_BACKEND=local

# Download Settings
MAX_CONCURRENT_DOWNLOADS=50
MAX_DOWNLOAD_SIZE=5GB
MAX_DURATION=7200

# yt-dlp Settings
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best
YTDLP_AUDIO_FORMAT=bestaudio/best
YTDLP_EMBED_THUMBNAIL=true
YTDLP_ADD_METADATA=true
YTDLP_EMBED_CHAPTERS=true
YTDLP_WRITE_SUBTITLES=true
YTDLP_SUBTITLE_LANGS=en,.*
YTDLP_EXTRACTOR_RETRIES=3
YTDLP_FRAGMENT_RETRIES=5
YTDLP_RETRIES=5

# FFmpeg Settings
FFMPEG_THREADS=4
FFMPEG_TIMEOUT=3600

# Security
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=30
ENABLE_SSRF_PROTECTION=true

# Workers
WORKER_COUNT=4
WORKER_TIMEOUT=3600

# Cookies (optional - for authenticated downloads)
# COOKIES_FILE=/cookies.txt
